# Backend (Baota / OS env)
# 本地开发默认与 application.yml 一致：root / 123456（与 docker-compose MySQL 一致）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=diet_management
DB_USERNAME=root
DB_PASSWORD=123456
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=
SPRING_PROFILES_ACTIVE=prod
FILE_UPLOAD_DIR=
FLYWAY_ENABLED=false

# Frontend: copy frontend/.env.production.example to frontend/.env.production before npm run build
